NODE_ENV=development
WORKER_HTTP_PORT=3002
DATABASE_URL=postgresql://postgres:160219@localhost:5432/leanmgmt_dev?schema=public
# RDS/Aurora (*.rds.amazonaws.com): TLS için `apps/api/certs/aws-rds-global-bundle.pem` monorepo yolundan otomatik; özel CA için DATABASE_SSL_CA
# DATABASE_SSL_CA=/absolute/path/to/ca.pem
REDIS_URL=redis://127.0.0.1:6379

# Doküman virüs taraması (BullMQ `document-virus-scan`). API upload sonrası kuyruğa job atar;
# worker çalışmazsa scanStatus PENDING_SCAN kalır. ClamAV yoksa development'ta otomatik CLEAN (prod'da CLAMAV_HOST gerekir).
# WORKER_SCAN_MOCK_CLEAN=true
# Gerçek ClamAV (ör. docker compose servisi): CLAMAV_HOST=127.0.0.1 CLAMAV_PORT=3310
# Development'ta bile ClamAV zorunlu olsun istiyorsanız: WORKER_REQUIRE_CLAMAV=true
# DOCUMENT_SCAN_QUEUE_NAME=document-virus-scan

# API ile aynı 64 hex — e-posta alıcısı decrypt (user:email:v1)
APP_PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# SLA taraması: BullMQ `sla-monitor` kuyruğu — 5 dk `check-task-sla` (docs/04 §11.2).
# SLA_MONITOR_QUEUE_NAME=sla-monitor

# Faz 7 — bildirim e-postası (BullMQ consumer + digest/cleanup)
# NOTIFICATION_EMAIL_QUEUE_NAME=notification-email-outbound
# Yerel Mailpit (docker compose mailpit): SMTP 1025
# EMAIL_SENDING_MODE=smtp
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Gönderen (biri yeterli): EMAIL_FROM_ADDRESS | SMTP_FROM_ADDRESS | SES_FROM_ADDRESS (legacy)
# EMAIL_FROM_ADDRESS=noreply@leanmgmt.local
# SMTP_FROM_NAME=Lean Management
# TLS (self-signed relay): SMTP_TLS_REJECT_UNAUTHORIZED=false
# CI / gerçek gönderim yok: EMAIL_SENDING_MODE=noop
# WEB_APP_BASE_URL=http://localhost:3000
# Günlük digest e-posta aralığı (ms), varsayılan 86400000
# NOTIFICATION_CRON_INTERVAL_MS=86400000
# In-app bildirim retention (ayrı cron, varsayılan 86400000)
# NOTIFICATION_RETENTION_CRON_INTERVAL_MS=86400000
# Gün sayısı: önce bu env, yoksa system_settings `IN_APP_NOTIFICATION_RETENTION_DAYS`, yoksa 90
# IN_APP_NOTIFICATION_RETENTION_DAYS=90
# Audit log zincir doğrulama (varsayılan 24 saat)
# AUDIT_CHAIN_CRON_INTERVAL_MS=86400000
